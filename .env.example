# ====================================================================
#  DALAL TERMINAL - environment configuration
#  Copy this file to ".env" and fill in the values.
#  NEVER commit your real .env  (it is git-ignored).
# ====================================================================

# --- Run mode --------------------------------------------------------
#   demo = synthetic data, NO keys needed (default - works out of the box)
#   live = streams real data from Zerodha Kite (requires keys below)
DALAL_MODE=demo

# --- Zerodha Kite Connect  (required only for DALAL_MODE=live) --------
#   1. Create an app at https://developers.kite.trade  (Rs.500 / month)
#   2. Historical candles need the separate Historical Data add-on.
#   3. KITE_ACCESS_TOKEN is generated every morning by the login routine
#      ("python main.py --login") - leave it blank here.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=http://127.0.0.1:8000/kite/callback
#   Optional: TOTP secret to semi-automate the daily login (advanced).
KITE_TOTP_SECRET=

# --- Web terminal ----------------------------------------------------
DALAL_HOST=127.0.0.1
DALAL_PORT=8000

# --- Historical-data provider  (Milestone 2) -------------------------
#   auto     = kite when API key+secret present, else yfinance (default)
#   kite     = force the Kite Historical API (needs the paid Historical
#              Data add-on, ~ Rs.2000/month on top of Kite Connect)
#   yfinance = force the free Yahoo Finance fallback
HISTORY_PROVIDER=auto

# --- Fundamentals provider  (Milestone 4) ----------------------------
#   yfinance (free, default) | twelvedata | fmp
FUNDAMENTALS_PROVIDER=yfinance
TWELVEDATA_API_KEY=
FMP_API_KEY=

# --- News provider  (Milestone 5) ------------------------------------
#   rss (free, default) | newsapi | finnhub
NEWS_PROVIDER=rss
NEWSAPI_KEY=
FINNHUB_API_KEY=

# --- Sentiment model  (Milestone 5) ----------------------------------
#   lexicon (default, no download) | finbert (downloads ~400MB model)
SENTIMENT_MODEL=lexicon

# --- Composite signal weights  (auto-normalised if they don't sum 1) -
WEIGHT_TECHNICAL=0.45
WEIGHT_FUNDAMENTAL=0.35
WEIGHT_NEWS=0.20

# --- Risk defaults ---------------------------------------------------
RISK_PER_TRADE_PCT=1.5
DEFAULT_CAPITAL=100000

# --- Storage / logging -----------------------------------------------
DB_PATH=data_cache/dalal.sqlite
LOG_LEVEL=INFO
